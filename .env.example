# Значения по умолчанию уже заданы в docker-compose.yml: `docker compose up` работает без .env.
# Файл нужен как справка и для переопределения (скопируйте в .env).

# Часовой пояс компании (RULES §1)
COMPANY_TZ=Asia/Bishkek

# За сколько рабочих дней до отпуска слать напоминание (RULES §8)
REMINDER_DAYS=3

# Демо-режим включён только при значении ровно "true" (RULES §9)
DEMO_MODE=true

# ТОЛЬКО ДЛЯ ДЕМО. Не использовать нигде, кроме локального запуска.
JWT_SECRET=demo-only-not-for-production

# Postgres (демо-значения)
POSTGRES_USER=leave
POSTGRES_PASSWORD=leave
POSTGRES_DB=leave
